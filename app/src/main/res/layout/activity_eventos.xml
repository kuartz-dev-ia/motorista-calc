<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070C14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0F1B2D"
            android:padding="16dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="➕ Novo Evento"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Extraia de um print ou preencha manualmente"
                android:textColor="#8B96AC"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp">

                <TextView
                    android:id="@+id/btnExtrairImagem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_verde"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="📷 Extrair dados de uma imagem (print/panfleto)"
                    android:textColor="#3DB8F5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="NOME DO EVENTO"
                    android:textColor="#1FE7A0"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:paddingBottom="4dp" />
                <EditText
                    android:id="@+id/edtNomeEvento"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_verde"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8B96AC"
                    android:hint="Preenchido automaticamente"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="ENDEREÇO / LOCAL"
                    android:textColor="#1FE7A0"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:paddingBottom="4dp" />
                <EditText
                    android:id="@+id/edtEnderecoEvento"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_verde"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8B96AC"
                    android:hint="Preenchido automaticamente"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Categoria"
                    android:textColor="#8B96AC"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/chipShow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_chip_selected"
                        android:gravity="center"
                        android:padding="9dp"
                        android:text="🎤 Show"
                        android:textColor="#08131A"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipJogo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:padding="9dp"
                        android:text="⚽ Jogo"
                        android:textColor="#8B96AC"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipOutroEvento"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:padding="9dp"
                        android:text="📍 Outro"
                        android:textColor="#8B96AC"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="DATA"
                    android:textColor="#1FE7A0"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:paddingBottom="4dp" />
                <EditText
                    android:id="@+id/edtDataEvento"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_verde"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8B96AC"
                    android:hint="Preenchida automaticamente"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="INÍCIO"
                            android:textColor="#1FE7A0"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:paddingBottom="4dp" />
                        <EditText
                            android:id="@+id/edtHorarioInicioEvento"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_input_verde"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#8B96AC"
                            android:hint="Automático"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="FIM PREVISTO (OPCIONAL)"
                            android:textColor="#1FE7A0"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:paddingBottom="4dp" />
                        <EditText
                            android:id="@+id/edtHorarioFimEvento"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_input_verde"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#8B96AC"
                            android:hint="Ex: 23:30"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnSalvarEvento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cta_start"
                    android:padding="13dp"
                    android:gravity="center"
                    android:text="Salvar evento"
                    android:textColor="#052018"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
