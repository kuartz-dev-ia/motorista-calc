<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📄 Documentos"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pendências"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/containerPendenciasDocumentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Novo documento"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="TIPO (ex: IPVA, Seguro, Licenciamento)"
                android:textColor="#1FE7A0"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />
            <EditText
                android:id="@+id/edtTipoDocumento"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_verde"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textColorHint="#8B96AC"
                android:hint="Tipo"
                android:textSize="14sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="DATA DE VENCIMENTO (DD/MM/AAAA)"
                android:textColor="#1FE7A0"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />
            <EditText
                android:id="@+id/edtDataVencimento"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_verde"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textColorHint="#8B96AC"
                android:hint="dd/mm/aaaa"
                android:textSize="14sp"
                android:inputType="date"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/btnSalvarDocumento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_green"
                android:padding="12dp"
                android:gravity="center"
                android:text="Salvar documento"
                android:textColor="#08131A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todos os documentos"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/containerListaDocumentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>          
