<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⛽ Combustível/Energia"
                android:textColor="#E7EAEE"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:paddingTop="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/chipGasolina"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:padding="9dp"
                    android:text="Gasolina"
                    android:textColor="#8A94A3"
                    android:textSize="10sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipEtanol"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_chip_selected"
                    android:gravity="center"
                    android:padding="9dp"
                    android:text="Etanol"
                    android:textColor="#06231F"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipGnv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:padding="9dp"
                    android:text="GNV"
                    android:textColor="#8A94A3"
                    android:textSize="10sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipEletrico"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:padding="9dp"
                    android:text="Elétrico"
                    android:textColor="#8A94A3"
                    android:textSize="10sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/txtLabelPrecoCombustivel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Preço por litro"
                    android:textColor="#8A94A3"
                    android:textSize="11sp"
                    android:paddingBottom="4dp" />
                <EditText
                    android:id="@+id/edtPrecoCombustivel"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_verde"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#E7EAEE"
                    android:textColorHint="#5D6773"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/txtLabelConsumoCombustivel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consumo do veículo (km/l)"
                    android:textColor="#8A94A3"
                    android:textSize="11sp"
                    android:paddingBottom="4dp" />
                <EditText
                    android:id="@+id/edtConsumo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_verde"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#E7EAEE"
                    android:textColorHint="#5D6773"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card_accent"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Custo por Km (Prévia)"
                        android:textColor="#8A94A3"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtCustoPorKmPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 0,00/km"
                        android:textColor="#2FB4A6"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resumo"
                    android:textColor="#E7EAEE"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/txtResumoCombustiveis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#8A94A3"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSalvar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cta_start"
                android:padding="14dp"
                android:gravity="center"
                android:text="Salvar"
                android:textColor="#06231F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
