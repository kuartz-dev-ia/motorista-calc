<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/txtTituloConfig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Config"
                android:textColor="#E7EAEE"
                android:textSize="18sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajustes do app e do veículo"
                android:textColor="#5D6773"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:paddingTop="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_accent"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Licença do app"
                    android:textColor="#E7EAEE"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/txtStatusLicenca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Verificando..."
                    android:textColor="#8A94A3"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/txtIdDispositivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ID do aparelho: carregando..."
                    android:textColor="#5D6773"
                    android:textSize="10.5sp"
                    android:textIsSelectable="true"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/edtChaveLicenca"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_verde"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#E7EAEE"
                    android:textColorHint="#5D6773"
                    android:hint="Cole sua chave de licença aqui"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp"
                    android:inputType="textCapCharacters" />

                <TextView
                    android:id="@+id/btnAtivarLicenca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cta_start"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="Ativar licença"
                    android:textColor="#06231F"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modo Escuro"
                        android:textColor="#E7EAEE"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Otimizado para condução noturna"
                        android:textColor="#5D6773"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Ativo"
                    android:textColor="#06231F"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Metas por Período"
                    android:textColor="#E7EAEE"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Meta Semanal (R$)"
                    android:textColor="#8A94A3"
                    android:textSize="11sp"
                    android:paddingBottom="4dp" />
                <EditText
                    android:id="@+id/edtMetaSemanal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_verde"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#E7EAEE"
                    android:textColorHint="#5D6773"
                    android:hint="Ex: 3500"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Meta Mensal (R$)"
                    android:textColor="#8A94A3"
                    android:textSize="11sp"
                    android:paddingBottom="4dp" />
                <EditText
                    android:id="@+id/edtMetaMensal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_verde"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#E7EAEE"
                    android:textColorHint="#5D6773"
                    android:hint="Ex: 14000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configuração de Combustível"
                    android:textColor="#E7EAEE"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/chipGasolina"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="Gasolina"
                        android:textColor="#8A94A3"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipEtanol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_chip_selected"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="Etanol"
                        android:textColor="#06231F"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipGnv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="GNV"
                        android:textColor="#8A94A3"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Preço por litro"
                    android:textColor="#8A94A3"
                    android:textSize="11sp"
                    android:paddingBottom="4dp" />
                <EditText
                    android:id="@+id/edtPrecoCombustivel"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_verde"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#E7EAEE"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consumo do veículo (km/l)"
                    android:textColor="#8A94A3"
                    android:textSize="11sp"
                    android:paddingBottom="4dp" />
                <EditText
                    android:id="@+id/edtConsumo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_verde"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#E7EAEE"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card_accent"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Custo por Km (Prévia)"
                        android:textColor="#8A94A3"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtCustoPorKmPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 0,00/km"
                        android:textColor="#2FB4A6"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnSalvarCombustivel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cta_start"
                    android:padding="13dp"
                    android:gravity="center"
                    android:text="Salvar Configurações"
                    android:textColor="#06231F"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resumo dos Combustíveis"
                    android:textColor="#E7EAEE"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/txtResumoCombustiveis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#8A94A3"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#C7CDD6"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/btnAtivarAcessibilidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_verde"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="1. Ativar serviço de acessibilidade"
                    android:textColor="#E7EAEE"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnPermitirOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_verde"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="2. Permitir exibir sobre outros apps"
                    android:textColor="#E7EAEE"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnVerDebugOcr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_verde"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="Ver texto lido pela câmera (debug OCR)"
                    android:textColor="#E7EAEE"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$/km mínimo aceitável"
                    android:textColor="#8A94A3"
                    android:textSize="11sp" />
                <EditText
                    android:id="@+id/edtMinKm"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_verde"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#E7EAEE"
                    android:inputType="numberDecimal"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$/hora mínimo aceitável"
                    android:textColor="#8A94A3"
                    android:textSize="11sp" />
                <EditText
                    android:id="@+id/edtMinHora"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_verde"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#E7EAEE"
                    android:inputType="numberDecimal"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Custos fixos mensais"
                    android:textColor="#E7EAEE"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="FINANCIAMENTO"
                            android:textColor="#5D6773"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:paddingBottom="4dp" />

                        <EditText
                            android:id="@+id/edtFinanciamento"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_input_verde"
                            android:gravity="center"
                            android:textColor="#E7EAEE"
                            android:hint="0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:inputType="numberDecimal" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="SEGURO"
                            android:textColor="#5D6773"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:paddingBottom="4dp" />

                        <EditText
                            android:id="@+id/edtSeguro"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_input_verde"
                            android:gravity="center"
                            android:textColor="#E7EAEE"
                            android:hint="0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:inputType="numberDecimal" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="IPVA (ANO)"
                            android:textColor="#5D6773"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:paddingBottom="4dp" />

                        <EditText
                            android:id="@+id/edtIpva"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_input_verde"
                            android:gravity="center"
                            android:textColor="#E7EAEE"
                            android:hint="0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:inputType="numberDecimal" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="LICENCIAMENTO"
                            android:textColor="#5D6773"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:paddingBottom="4dp" />

                        <EditText
                            android:id="@+id/edtLicenciamento"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_input_verde"
                            android:gravity="center"
                            android:textColor="#E7EAEE"
                            android:hint="0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:inputType="numberDecimal" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="MANUTENÇÃO"
                            android:textColor="#5D6773"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:paddingBottom="4dp" />

                        <EditText
                            android:id="@+id/edtManutencao"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_input_verde"
                            android:gravity="center"
                            android:textColor="#E7EAEE"
                            android:hint="0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:inputType="numberDecimal" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="CONTAS PESSOAIS"
                            android:textColor="#5D6773"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:paddingBottom="4dp" />

                        <EditText
                            android:id="@+id/edtContasPessoais"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_input_verde"
                            android:gravity="center"
                            android:textColor="#E7EAEE"
                            android:hint="0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:inputType="numberDecimal" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="KM RODADOS POR MÊS (MÉDIA)"
                    android:textColor="#5D6773"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:paddingBottom="4dp" />
                <EditText
                    android:id="@+id/edtKmMes"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input_verde"
                    android:gravity="center"
                    android:textColor="#E7EAEE"
                    android:hint="0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Segurança"
                    android:textColor="#E7EAEE"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avisar pausa a cada quantas horas dirigindo"
                    android:textColor="#8A94A3" />
                <EditText
                    android:id="@+id/edtLimitePausa"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_verde"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#E7EAEE"
                    android:inputType="numberDecimal"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnAbrirBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Backup e Restauração"
                    android:textColor="#E7EAEE"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#5D6773"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardGeradorChaveDev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_accent"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔑 Gerador de chaves (uso interno)"
                    android:textColor="#E7EAEE"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txtChaveGerada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_verde"
                    android:padding="14dp"
                    android:gravity="center"
                    android:text="Toque em gerar"
                    android:textColor="#2FB4A6"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textIsSelectable="true"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnGerarChave"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_cta_start"
                        android:padding="12dp"
                        android:gravity="center"
                        android:text="Gerar nova chave"
                        android:textColor="#06231F"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnCopiarChaveGerada"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_verde"
                        android:padding="12dp"
                        android:gravity="center"
                        android:text="Copiar"
                        android:textColor="#E7EAEE"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnSalvar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cta_start"
                android:padding="14dp"
                android:gravity="center"
                android:text="Salvar configurações"
                android:textColor="#06231F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
