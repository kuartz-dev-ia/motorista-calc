<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1013">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parâmetros"
            android:textColor="#F4F5F7"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E4E7EC"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnAtivarAcessibilidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Ativar serviço de acessibilidade" />

            <Button
                android:id="@+id/btnPermitirOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="2. Permitir exibir sobre outros apps" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parâmetros de cálculo"
                android:textColor="#F4F5F7"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:text="R$/KM MÍNIMO"
                        android:textColor="#8FB868"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtMinKm"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#EAF3DE"
                        android:textColorHint="#3F5A34"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:text="R$/HORA MÍNIMO"
                        android:textColor="#8FB868"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtMinHora"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#EAF3DE"
                        android:textColorHint="#3F5A34"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:text="CONSUMO (KM/L)"
                        android:textColor="#8FB868"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtConsumo"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#EAF3DE"
                        android:textColorHint="#3F5A34"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:text="COMBUSTÍVEL (R$/L)"
                        android:textColor="#8FB868"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtPrecoCombustivel"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#EAF3DE"
                        android:textColorHint="#3F5A34"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custos fixos mensais"
                android:textColor="#F4F5F7"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:text="FINANCIAMENTO"
                        android:textColor="#8FB868"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtFinanciamento"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#EAF3DE"
                        android:textColorHint="#3F5A34"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:text="SEGURO"
                        android:textColor="#8FB868"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtSeguro"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#EAF3DE"
                        android:textColorHint="#3F5A34"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:text="IPVA (ANO)"
                        android:textColor="#8FB868"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtIpva"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#EAF3DE"
                        android:textColorHint="#3F5A34"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:text="LICENCIAMENTO"
                        android:textColor="#8FB868"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtLicenciamento"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#EAF3DE"
                        android:textColorHint="#3F5A34"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:text="MANUTENÇÃO"
                        android:textColor="#8FB868"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtManutencao"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#EAF3DE"
                        android:textColorHint="#3F5A34"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:text="CONTAS PESSOAIS"
                        android:textColor="#8FB868"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtContasPessoais"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#EAF3DE"
                        android:textColorHint="#3F5A34"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="KM RODADOS POR MÊS (MÉDIA)"
                    android:textColor="#8FB868"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtKmMes"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input_verde"
                    android:gravity="center"
                    android:textColor="#EAF3DE"
                    android:textColorHint="#3F5A34"
                    android:hint="0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:inputType="numberDecimal" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Segurança"
                android:textColor="#F4F5F7"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avisar pausa a cada quantas horas dirigindo"
                android:textColor="#9AA4B2" />
            <EditText
                android:id="@+id/edtLimitePausa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F4F5F7"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_green"
            android:padding="14dp"
            android:gravity="center"
            android:text="Salvar configurações"
            android:textColor="#EAF3DE"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
