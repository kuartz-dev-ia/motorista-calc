<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1013">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⛽ Abastecimentos"
            android:textColor="#F4F5F7"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Novo abastecimento"
                android:textColor="#F4F5F7"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:text="LITROS"
                        android:textColor="#8FB868"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtLitros"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#EAF3DE"
                        android:textColorHint="#3F5A34"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:text="VALOR TOTAL (R$)"
                        android:textColor="#8FB868"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtValorAbastecimento"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#EAF3DE"
                        android:textColorHint="#3F5A34"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="KM ATUAL DO PAINEL"
                android:textColor="#8FB868"
                android:textSize="10.5sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/edtKmAtual"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_verde"
                android:gravity="center"
                android:textColor="#EAF3DE"
                android:textColorHint="#3F5A34"
                android:hint="0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:inputType="numberDecimal"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/btnSalvarAbastecimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_green"
                android:padding="12dp"
                android:gravity="center"
                android:text="Salvar abastecimento"
                android:textColor="#EAF3DE"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/txtConsumoMedio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#9AA4B2"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/btnUsarConsumoReal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_verde"
                android:padding="10dp"
                android:gravity="center"
                android:text="✓ Usar este consumo nos cálculos de corrida"
                android:textColor="#EAF3DE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Histórico"
                android:textColor="#F4F5F7"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/containerAbastecimentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
