<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 Metas"
                android:textColor="#E7EAEE"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:paddingTop="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Metas por Período"
                    android:textColor="#E7EAEE"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Meta Semanal (R$)"
                    android:textColor="#8A94A3"
                    android:textSize="11sp"
                    android:paddingBottom="4dp" />
                <EditText
                    android:id="@+id/edtMetaSemanal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_verde"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#E7EAEE"
                    android:textColorHint="#5D6773"
                    android:hint="Ex: 3500"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Meta Mensal (R$)"
                    android:textColor="#8A94A3"
                    android:textSize="11sp"
                    android:paddingBottom="4dp" />
                <EditText
                    android:id="@+id/edtMetaMensal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_verde"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#E7EAEE"
                    android:textColorHint="#5D6773"
                    android:hint="Ex: 14000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meta Bruta Necessária"
                    android:textColor="#E7EAEE"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Soma custos fixos + Minhas Contas + combustível estimado e divide pelos dias que você pretende trabalhar"
                    android:textColor="#5D6773"
                    android:textSize="11sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dias que pretendo trabalhar no mês"
                    android:textColor="#8A94A3"
                    android:textSize="11sp"
                    android:paddingBottom="4dp" />
                <EditText
                    android:id="@+id/edtDiasTrabalhoMes"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_verde"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#E7EAEE"
                    android:textColorHint="#5D6773"
                    android:hint="Ex: 22"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:inputType="number"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_accent"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VOCÊ PRECISA FATURAR (BRUTO)"
                        android:textColor="#5D6773"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtMetaBrutaPreviewConfig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 0,00/dia"
                        android:textColor="#2FB4A6"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtMetaBrutaSubtituloConfig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="pra cobrir R$ 0,00/mês"
                        android:textColor="#8A94A3"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnSalvar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cta_start"
                android:padding="14dp"
                android:gravity="center"
                android:text="Salvar"
                android:textColor="#06231F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
