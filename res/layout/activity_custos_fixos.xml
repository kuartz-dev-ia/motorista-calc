<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 Custos Fixos Mensais"
                android:textColor="#E7EAEE"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:paddingTop="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="FINANCIAMENTO"
                        android:textColor="#5D6773"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:paddingBottom="4dp" />

                    <EditText
                        android:id="@+id/edtFinanciamento"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#E7EAEE"
                        android:textColorHint="#5D6773"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="SEGURO"
                        android:textColor="#5D6773"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:paddingBottom="4dp" />

                    <EditText
                        android:id="@+id/edtSeguro"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#E7EAEE"
                        android:textColorHint="#5D6773"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="IPVA (ANO)"
                        android:textColor="#5D6773"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:paddingBottom="4dp" />

                    <EditText
                        android:id="@+id/edtIpva"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#E7EAEE"
                        android:textColorHint="#5D6773"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="LICENCIAMENTO"
                        android:textColor="#5D6773"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:paddingBottom="4dp" />

                    <EditText
                        android:id="@+id/edtLicenciamento"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#E7EAEE"
                        android:textColorHint="#5D6773"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="MANUTENÇÃO"
                        android:textColor="#5D6773"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:paddingBottom="4dp" />

                    <EditText
                        android:id="@+id/edtManutencao"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#E7EAEE"
                        android:textColorHint="#5D6773"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="CONTAS PESSOAIS"
                        android:textColor="#5D6773"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:paddingBottom="4dp" />

                    <EditText
                        android:id="@+id/edtContasPessoais"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_verde"
                        android:gravity="center"
                        android:textColor="#E7EAEE"
                        android:textColorHint="#5D6773"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="KM RODADOS POR MÊS (MÉDIA)"
                android:textColor="#5D6773"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />
            <EditText
                android:id="@+id/edtKmMes"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_verde"
                android:gravity="center"
                android:textColor="#E7EAEE"
                android:textColorHint="#5D6773"
                android:hint="0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:inputType="numberDecimal"
                android:layout_marginBottom="18dp" />

            <TextView
                android:id="@+id/btnSalvar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cta_start"
                android:padding="14dp"
                android:gravity="center"
                android:text="Salvar"
                android:textColor="#06231F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
